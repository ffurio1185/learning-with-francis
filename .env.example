# Example names only. The application does not automatically load .env files.
# Generate a real secret outside Git; never use this blank example in production.
LWF_SECRET_KEY=
LWF_DATA_DIR=/tmp/learning-with-francis
# Free demonstration: show the bilingual temporary-progress notice.
LWF_DEMO_MODE=1
# On Render, RENDER_EXTERNAL_HOSTNAME is used unless this is explicitly set.
# Set actual exact hostname(s), comma-separated, when using a custom domain.
LWF_ALLOWED_HOSTS=
