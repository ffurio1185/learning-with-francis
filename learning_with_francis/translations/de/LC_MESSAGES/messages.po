msgstr "oder"

#: learning_with_francis/templates/subject_lesson.html:32
msgid "). Use"
msgstr "). Verwende"

#: learning_with_francis/templates/subject_lesson.html:32
msgid "for a binding you will reassign."
msgstr "für eine Bindung, der du später einen anderen Wert zuweisen möchtest."

#: learning_with_francis/templates/subject_lesson.html:32
