#: learning_with_francis/templates/sql_lesson.html:17
msgid "1. Choose columns with SELECT"
msgstr "1. Spalten mit SELECT auswählen"

#: learning_with_francis/templates/sql_lesson.html:18
msgid "says which columns to show."
msgstr "legt fest, welche Spalten angezeigt werden."

#: learning_with_francis/templates/sql_lesson.html:18
msgid "says which table to read. Separate several column names with commas."
msgstr ""
"legt fest, aus welcher Tabelle gelesen wird. Trenne mehrere Spaltennamen "
"durch Kommas."

#: learning_with_francis/templates/sql_lesson.html:20
msgid ""
