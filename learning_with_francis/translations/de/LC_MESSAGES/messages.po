#: learning_with_francis/__init__.py:79
msgid "You do not have access to this page."
msgstr "Du hast keinen Zugriff auf diese Seite."

#: learning_with_francis/__init__.py:80
msgid "This page or result is not available for your visit."
msgstr "Diese Seite oder dieses Ergebnis ist für deinen Besuch nicht verfügbar."

#: learning_with_francis/__init__.py:81
msgid "This action is not available with that request method."
msgstr "Diese Aktion ist mit dieser Anfragemethode nicht verfügbar."

#: learning_with_francis/__init__.py:82 learning_with_francis/learning.py:115
msgid "This form was already submitted with different answers. Use Try Again."
msgstr "Dieses Formular wurde bereits mit anderen Antworten abgeschickt. Wähle „Erneut versuchen“."

#: learning_with_francis/__init__.py:83
msgid "This submission is too large. Please submit a smaller form."
msgstr "Diese Eingabe ist zu groß. Bitte sende ein kleineres Formular."

#: learning_with_francis/__init__.py:86
msgid "The request could not be processed. Please try again."
msgstr "Die Anfrage konnte nicht verarbeitet werden. Bitte versuche es erneut."

#: learning_with_francis/__init__.py:101 learning_with_francis/__init__.py:114
#: learning_with_francis/i18n.py:49 learning_with_francis/i18n.py:59
#: learning_with_francis/learning.py:170 learning_with_francis/learning.py:200
msgid "This form has expired. Please try again."
msgstr "Dieses Formular ist abgelaufen. Bitte versuche es erneut."

#: learning_with_francis/__init__.py:119
msgid "Start a fresh visit below."
msgstr "Beginne unten einen neuen Besuch."

#: learning_with_francis/__init__.py:119
msgid "Your visit has ended. Your saved history is retained."
msgstr "Dein Besuch ist beendet. Dein gespeicherter Verlauf bleibt erhalten."

#: learning_with_francis/i18n.py:53
msgid "Please choose English or German."
msgstr "Bitte wähle Englisch oder Deutsch."

#: learning_with_francis/i18n.py:67
msgid "Still Learning"
msgstr "Noch am Lernen"

#: learning_with_francis/i18n.py:68
msgid "Needs Review"
msgstr "Wiederholung nötig"

#: learning_with_francis/i18n.py:68
msgid "Completed"
msgstr "Abgeschlossen"

#: learning_with_francis/learning.py:68
msgid "This activity form has expired or is invalid. Please open it again."
msgstr "Dieses Aufgabenformular ist abgelaufen oder ungültig. Bitte öffne es erneut."

#: learning_with_francis/learning.py:73
msgid "This activity form belongs to a different visit or activity. Please open it again."
msgstr "Dieses Formular gehört zu einem anderen Besuch oder einer anderen Aufgabe. Bitte öffne es erneut."

#: learning_with_francis/learning.py:84
msgid "Please submit answers only for this activity's questions."
msgstr "Bitte sende nur Antworten auf die Fragen dieser Aufgabe."

#: learning_with_francis/learning.py:88
msgid "Please choose one listed answer for every question."
msgstr "Bitte wähle für jede Frage genau eine der angebotenen Antworten."

#: learning_with_francis/learning.py:204
msgid "This practice question is invalid. Please start again."
msgstr "Diese Übungsfrage ist ungültig. Bitte beginne erneut."

#: learning_with_francis/learning.py:206
msgid "This form does not match the displayed question. Please try again."
msgstr "Dieses Formular passt nicht zur angezeigten Frage. Bitte versuche es erneut."

#: learning_with_francis/learning.py:212
msgid "Please answer the earlier practice questions first."
msgstr "Bitte beantworte zuerst die vorherigen Übungsfragen."

#: learning_with_francis/learning.py:248
msgid "This practice form has expired or is invalid. Please start again."
msgstr "Dieses Übungsformular ist abgelaufen oder ungültig. Bitte beginne erneut."

#: learning_with_francis/learning.py:254
msgid "This practice form belongs to a different visit or round. Please start again."
msgstr ""
"Dieses Übungsformular gehört zu einem anderen Besuch oder einer anderen Runde. Bitte beginne "
"erneut."

#: learning_with_francis/progress.py:71
msgid "Choose Still Learning, Needs Review, or Completed."
msgstr "Wähle „Noch am Lernen“, „Wiederholung nötig“ oder „Abgeschlossen“."

#: learning_with_francis/progress.py:73
msgid "Confirmation must come from your confirmation checkbox."
msgstr "Die Bestätigung muss über das Bestätigungsfeld erfolgen."

#: learning_with_francis/progress.py:75
msgid "Please confirm that you understand this topic before selecting Completed."
msgstr "Bitte bestätige, dass du dieses Thema verstanden hast, bevor du „Abgeschlossen“ auswählst."

#: learning_with_francis/progress.py:121
msgid "This form has expired. Please reload My Progress and try again."
msgstr "Dieses Formular ist abgelaufen. Bitte lade „Mein Fortschritt“ neu und versuche es erneut."

#: learning_with_francis/progress.py:125
msgid "Please choose one learning status."
msgstr "Bitte wähle genau einen Lernstatus."

#: learning_with_francis/progress.py:130
msgid "Your learning status is saved. Practice and quiz results stay separate from understanding."
msgstr ""
"Dein Lernstatus wurde gespeichert. Übungs- und Quizergebnisse bleiben unabhängig von deinem "
"Verständnis."

#: learning_with_francis/sql_content.py:13
msgid "Which query shows only the names of learners whose city is Berlin?"
msgstr "Welche Abfrage zeigt nur die Namen der Lernenden, deren Stadt Berlin ist?"

#: learning_with_francis/sql_content.py:17
msgid "SELECT name chooses the name column. WHERE city = 'Berlin' keeps only rows for Berlin."
msgstr "SELECT name wählt die Spalte name aus. WHERE city = 'Berlin' behält nur Zeilen für Berlin."

#: learning_with_francis/sql_content.py:18
msgid "Which query shows every column from the learners table?"
msgstr "Welche Abfrage zeigt alle Spalten der Tabelle learners?"

#: learning_with_francis/sql_content.py:21
msgid "The star (*) after SELECT means every column. Here that means name, city and age."
msgstr "Das Sternchen (*) nach SELECT steht für alle Spalten. Hier sind das name, city und age."

#: learning_with_francis/sql_content.py:22
msgid "Which query displays only the age column?"
msgstr "Welche Abfrage zeigt nur die Spalte age?"

#: learning_with_francis/sql_content.py:25
msgid "Put the column you want after SELECT. SELECT age reads only the age column."
msgstr "Schreibe die gewünschte Spalte hinter SELECT. SELECT age liest nur die Spalte age."

#: learning_with_francis/sql_content.py:26
msgid "How do you display the name and age columns together?"
msgstr "Wie zeigst du die Spalten name und age gemeinsam an?"

#: learning_with_francis/sql_content.py:29
msgid "A comma separates column names. SELECT name, age displays both columns."
msgstr "Ein Komma trennt Spaltennamen. SELECT name, age zeigt beide Spalten an."

#: learning_with_francis/sql_content.py:30
msgid "In SELECT name FROM learners;, what does FROM learners tell SQL?"
msgstr "Was legt FROM learners in SELECT name FROM learners; fest?"

#: learning_with_francis/sql_content.py:31
msgid "Read rows from the learners table"
msgstr "Zeilen aus der Tabelle learners lesen"

#: learning_with_francis/sql_content.py:31
msgid "Display a column called learners"
msgstr "Eine Spalte namens learners anzeigen"

#: learning_with_francis/sql_content.py:32
msgid "Keep only learners called name"
msgstr "Nur Lernende mit dem Namen name behalten"

#: learning_with_francis/sql_content.py:33
msgid "FROM identifies the table to read. SELECT identifies the columns to display."
msgstr "FROM legt die Tabelle fest, aus der gelesen wird. SELECT legt die anzuzeigenden Spalten fest."

#: learning_with_francis/sql_content.py:34
msgid "Which name matches SELECT name FROM learners WHERE age < 18;?"
msgstr "Welcher Name wird von SELECT name FROM learners WHERE age < 18; zurückgegeben?"

#: learning_with_francis/sql_content.py:36
msgid "Mia is 16, so she matches age < 18. Alex is 22 and Sam is 19."
msgstr "Mia ist 16 und erfüllt daher die Bedingung age < 18. Alex ist 22 und Sam ist 19."

#: learning_with_francis/sql_content.py:37
msgid "Which learners match WHERE age >= 18?"
msgstr "Welche Lernenden erfüllen die Bedingung WHERE age >= 18?"

#: learning_with_francis/sql_content.py:38
msgid "Alex and Sam"
msgstr "Alex und Sam"

#: learning_with_francis/sql_content.py:38
msgid "Only Mia"
msgstr "Nur Mia"

#: learning_with_francis/sql_content.py:38
msgid "All three learners"
msgstr "Alle drei Lernenden"

#: learning_with_francis/sql_content.py:39
msgid "Greater than or equal to 18 includes Alex (22) and Sam (19). Mia (16) does not match."
msgstr "Größer oder gleich 18 trifft auf Alex (22) und Sam (19) zu. Mia (16) erfüllt die Bedingung nicht."

#: learning_with_francis/sql_content.py:40
msgid "Which condition keeps only learners whose city is Hamburg?"
msgstr "Welche Bedingung behält nur Lernende, deren Stadt Hamburg ist?"

#: learning_with_francis/sql_content.py:42
msgid "Compare the city column with the text 'Hamburg'. Single quotes identify the text value."
msgstr ""
"Vergleiche die Spalte city mit dem Text 'Hamburg'. Einfache Anführungszeichen kennzeichnen den "
"Textwert."

#: learning_with_francis/sql_content.py:43
msgid "Which name matches SELECT name FROM learners WHERE age = 19;?"
msgstr "Welcher Name wird von SELECT name FROM learners WHERE age = 19; zurückgegeben?"

#: learning_with_francis/sql_content.py:45
msgid "The equals sign keeps an exact match. Sam is 19, so only Sam's row is returned."
msgstr ""
"Das Gleichheitszeichen verlangt eine genaue Übereinstimmung. Sam ist 19, daher wird nur Sams "
"Zeile zurückgegeben."

#: learning_with_francis/sql_content.py:46
msgid "Which name matches SELECT name FROM learners WHERE age > 20;?"
msgstr "Welcher Name wird von SELECT name FROM learners WHERE age > 20; zurückgegeben?"

#: learning_with_francis/sql_content.py:48
msgid "The > symbol means greater than. Alex is 22, so he is the only learner older than 20."
msgstr "Das Zeichen > bedeutet größer als. Alex ist 22 und damit der einzige Lernende über 20."

#: learning_with_francis/sql_content.py:52
msgid "What does SELECT choose in a query?"
msgstr "Was wählt SELECT in einer Abfrage aus?"

#: learning_with_francis/sql_content.py:53
msgid "The table's name"
msgstr "Den Namen der Tabelle"

#: learning_with_francis/sql_content.py:53
msgid "The columns to display"
msgstr "Die anzuzeigenden Spalten"

#: learning_with_francis/sql_content.py:53
msgid "The rows to delete"
msgstr "Die zu löschenden Zeilen"

#: learning_with_francis/sql_content.py:54
msgid "The column names after SELECT decide which columns appear in the result."
msgstr "Die Spaltennamen hinter SELECT legen fest, welche Spalten im Ergebnis erscheinen."

#: learning_with_francis/sql_content.py:55
msgid "Which query displays the name and city columns for every learner?"
msgstr "Welche Abfrage zeigt die Spalten name und city für alle Lernenden?"

#: learning_with_francis/sql_content.py:58
msgid "Separate selected column names with a comma. FROM names the table: learners."
msgstr "Trenne die ausgewählten Spaltennamen mit einem Komma. FROM benennt die Tabelle: learners."

#: learning_with_francis/sql_content.py:59
msgid "Which query displays learners aged 18 or older?"
msgstr "Welche Abfrage zeigt Lernende, die mindestens 18 Jahre alt sind?"

#: learning_with_francis/sql_content.py:62
msgid ""
"WHERE age >= 18 keeps rows where age is greater than or equal to 18. The star selects every "
"column."
msgstr ""
"WHERE age >= 18 behält Zeilen, deren age-Wert mindestens 18 ist. Das Sternchen wählt alle Spalten"
" aus."

#: learning_with_francis/sql_content.py:63
msgid "Which WHERE condition correctly matches the text value Berlin?"
msgstr "Welche WHERE-Bedingung vergleicht korrekt mit dem Textwert Berlin?"

#: learning_with_francis/sql_content.py:65
msgid "Text values use single quotes. The equals sign compares the city column with the text 'Berlin'."
msgstr ""
"Textwerte stehen in einfachen Anführungszeichen. Das Gleichheitszeichen vergleicht die Spalte "
"city mit dem Text 'Berlin'."

#: learning_with_francis/sql_content.py:66
msgid ""
"Using the lesson's learners table, which name is returned by SELECT name FROM learners WHERE age "
"< 18;?"
msgstr ""
"Welcher Name wird bei der Beispieltabelle learners aus der Lektion von SELECT name FROM learners "
"WHERE age < 18; zurückgegeben?"

#: learning_with_francis/sql_content.py:68
msgid "Mia is 16, so her row matches age < 18. Alex (22) and Sam (19) do not match."
msgstr ""
"Mia ist 16, daher erfüllt ihre Zeile age < 18. Alex (22) und Sam (19) erfüllen diese Bedingung "
"nicht."

#: learning_with_francis/sql_display.py:9 learning_with_francis/templates/sql_lesson.html:3
msgid "SELECT and WHERE"
msgstr "SELECT und WHERE"

#: learning_with_francis/sql_display.py:9
msgid "Reading tables with SELECT and WHERE"
msgstr "Tabellen mit SELECT und WHERE lesen"

#: learning_with_francis/sql_display.py:69
#, python-format
msgid "Well done, %(name)s! You solved the practice exercise."
msgstr "Gut gemacht, %(name)s! Du hast die Übungsaufgabe richtig gelöst."

#: learning_with_francis/sql_display.py:70
#, python-format
msgid "Keep practicing, %(name)s! Read the explanation and try again."
msgstr "Übe weiter, %(name)s! Lies die Erklärung und versuche es erneut."

#: learning_with_francis/sql_display.py:72
#, python-format
msgid "Keep practicing, %(name)s! Review the lesson and try again. You can do it!"
msgstr "Übe weiter, %(name)s! Wiederhole die Lektion und versuche es erneut. Du schaffst das!"

#: learning_with_francis/sql_display.py:74
#, python-format
msgid "Well done, %(name)s! You passed the quiz. Keep practicing to improve your score!"
msgstr "Gut gemacht, %(name)s! Du hast das Quiz bestanden. Übe weiter, um deine Punktzahl zu verbessern!"

#: learning_with_francis/sql_display.py:75
#, python-format
msgid "Congratulations, %(name)s! Perfect score! You answered all five questions correctly!"
msgstr "Herzlichen Glückwunsch, %(name)s! Volle Punktzahl! Du hast alle fünf Fragen richtig beantwortet!"

#: learning_with_francis/subjects.py:42
msgid "What does age = 20 do?"
msgstr "Was bewirkt age = 20?"

#: learning_with_francis/subjects.py:42
msgid "Stores 20 under the name age"
msgstr "Speichert 20 unter dem Namen age"

#: learning_with_francis/subjects.py:42
msgid "Prints 20"
msgstr "Gibt 20 aus"

#: learning_with_francis/subjects.py:42
msgid "Defines a function"
msgstr "Definiert eine Funktion"

#: learning_with_francis/subjects.py:42
msgid "The equals sign assigns a value to a variable name."
msgstr "Das Gleichheitszeichen weist einem Variablennamen einen Wert zu."

#: learning_with_francis/subjects.py:43
msgid "Which value is a string?"
msgstr "Welcher Wert ist eine Zeichenkette?"

#: learning_with_francis/subjects.py:43
msgid "Quotes mark text. 'Hello' is a string; 20 is an integer and False is a boolean."
msgstr ""
"Anführungszeichen kennzeichnen Text. 'Hello' ist eine Zeichenkette; 20 ist eine ganze Zahl und "
"False ein boolescher Wert."

#: learning_with_francis/subjects.py:44
msgid "What is count after count = 2 followed by count = count + 3?"
msgstr "Welchen Wert hat count nach count = 2 und anschließend count = count + 3?"

#: learning_with_francis/subjects.py:44
msgid "Read the old value 2, add 3, then store 5 in count."
msgstr "Der bisherige Wert 2 wird gelesen, um 3 erhöht und als 5 in count gespeichert."

#: learning_with_francis/subjects.py:45
msgid "Which keyword defines a Python function?"
msgstr "Welches Schlüsselwort definiert eine Python-Funktion?"

#: learning_with_francis/subjects.py:45
msgid "Use def, a function name, parentheses and a colon to define a function."
msgstr "Eine Funktion wird mit def, einem Funktionsnamen, Klammern und einem Doppelpunkt definiert."

#: learning_with_francis/subjects.py:46
msgid "Which line calls a function named greet?"
msgstr "Welche Zeile ruft eine Funktion namens greet auf?"

#: learning_with_francis/subjects.py:46
msgid "Parentheses call a function. A definition alone does not run its body."
msgstr "Klammern rufen eine Funktion auf. Die Definition allein führt ihren Funktionskörper nicht aus."

#: learning_with_francis/subjects.py:47
msgid "In def add_one(number):, what is number?"
msgstr "Was ist number in def add_one(number):?"

#: learning_with_francis/subjects.py:47
msgid "The result"
msgstr "Das Ergebnis"

#: learning_with_francis/subjects.py:47
msgid "A table"
msgstr "Eine Tabelle"

#: learning_with_francis/subjects.py:47
msgid "An input parameter"
msgstr "Ein Eingabeparameter"

#: learning_with_francis/subjects.py:47
msgid "A parameter is a name for a value supplied when a function is called."
msgstr "Ein Parameter ist ein Name für einen Wert, der beim Aufruf einer Funktion übergeben wird."

#: learning_with_francis/subjects.py:48
msgid "What does return do inside a function?"
msgstr "Was bewirkt return innerhalb einer Funktion?"

#: learning_with_francis/subjects.py:48
msgid "Sends a value back to the caller"
msgstr "Gibt einen Wert an die aufrufende Stelle zurück"

#: learning_with_francis/subjects.py:48
msgid "Always prints text"
msgstr "Gibt immer Text aus"

#: learning_with_francis/subjects.py:48
msgid "Starts a browser"
msgstr "Startet einen Browser"

#: learning_with_francis/subjects.py:48
msgid "return ends the function call and supplies its result to the caller."
msgstr "return beendet den Funktionsaufruf und gibt dessen Ergebnis an die aufrufende Stelle zurück."

#: learning_with_francis/subjects.py:49
msgid "If add_one returns number + 1, what is add_one(4)?"
msgstr "Wenn add_one den Wert number + 1 zurückgibt, was ergibt add_one(4)?"

#: learning_with_francis/subjects.py:49
msgid "The argument 4 becomes number, so number + 1 gives 5."
msgstr "Das Argument 4 wird zum Wert von number. Daher ergibt number + 1 den Wert 5."

#: learning_with_francis/subjects.py:50
msgid "What marks a function's body in Python?"
msgstr "Woran erkennt man den Funktionskörper in Python?"

#: learning_with_francis/subjects.py:50
msgid "Quotation marks"
msgstr "An Anführungszeichen"

#: learning_with_francis/subjects.py:50
msgid "A semicolon only"
msgstr "Nur an einem Semikolon"

#: learning_with_francis/subjects.py:50
msgid "Indentation"
msgstr "An der Einrückung"

#: learning_with_francis/subjects.py:50
msgid "Indented statements belong to the function. Use consistent indentation, normally four spaces."
msgstr ""
"Eingerückte Anweisungen gehören zur Funktion. Verwende eine einheitliche Einrückung, "
"üblicherweise vier Leerzeichen."

#: learning_with_francis/subjects.py:51
msgid "Why store result = add_one(4)?"
msgstr "Warum speichert man result = add_one(4)?"

#: learning_with_francis/subjects.py:51
msgid "It deletes the function"
msgstr "Dadurch wird die Funktion gelöscht"

#: learning_with_francis/subjects.py:51
msgid "It lets you reuse the returned value"
msgstr "So lässt sich der Rückgabewert erneut verwenden"

#: learning_with_francis/subjects.py:51
msgid "It prints automatically"
msgstr "Dadurch wird automatisch etwas ausgegeben"

#: learning_with_francis/subjects.py:51
msgid "The return value 5 is assigned to result. You can use it later or print it."
msgstr "Der Rückgabewert 5 wird result zugewiesen. Du kannst ihn später verwenden oder ausgeben."

#: learning_with_francis/subjects.py:54
msgid "What value is stored by name = 'Mia'?"
msgstr "Welcher Wert wird durch name = 'Mia' gespeichert?"

#: learning_with_francis/subjects.py:54
msgid "The number 3"
msgstr "Die Zahl 3"

#: learning_with_francis/subjects.py:54
msgid "The text Mia"
msgstr "Der Text Mia"

#: learning_with_francis/subjects.py:54
msgid "A boolean"
msgstr "Ein boolescher Wert"

#: learning_with_francis/subjects.py:54
msgid "Quoted text is a string. The variable name refers to that text."
msgstr "Text in Anführungszeichen ist eine Zeichenkette. Der Variablenname verweist auf diesen Text."

#: learning_with_francis/subjects.py:55
msgid "What is points after points = 3; points = points + 2?"
msgstr "Welchen Wert hat points nach points = 3; points = points + 2?"

#: learning_with_francis/subjects.py:55
msgid "The second assignment adds 2 to the previous value 3."
msgstr "Die zweite Zuweisung addiert 2 zum bisherigen Wert 3."

#: learning_with_francis/subjects.py:56
msgid "Which definition returns its input plus one?"
msgstr "Welche Definition gibt den Eingabewert um eins erhöht zurück?"

#: learning_with_francis/subjects.py:56
msgid "The first function uses its parameter value and returns value + 1."
msgstr "Die erste Funktion verwendet ihren Parameter value und gibt value + 1 zurück."

#: learning_with_francis/subjects.py:57
msgid "How do you call add_one with the number 6?"
msgstr "Wie rufst du add_one mit der Zahl 6 auf?"

#: learning_with_francis/subjects.py:57
msgid "Put the supplied value inside parentheses after the function name."
msgstr "Schreibe den übergebenen Wert in Klammern hinter den Funktionsnamen."

#: learning_with_francis/subjects.py:58
msgid "How does return differ from print()?"
msgstr "Wie unterscheidet sich return von print()?"

#: learning_with_francis/subjects.py:58
msgid "Both always save to SQLite"
msgstr "Beide speichern immer in SQLite"

#: learning_with_francis/subjects.py:58
msgid "return displays a webpage"
msgstr "return zeigt eine Webseite an"

#: learning_with_francis/subjects.py:58
msgid "return supplies a result; print displays output"
msgstr "return liefert ein Ergebnis; print gibt etwas aus"

#: learning_with_francis/subjects.py:58
msgid "A caller can store and reuse a returned value. print writes output instead."
msgstr ""
"Die aufrufende Stelle kann einen Rückgabewert speichern und erneut verwenden. print schreibt "
"stattdessen eine Ausgabe."

#: learning_with_francis/subjects.py:63
msgid "Which value is a JavaScript string?"
msgstr "Welcher Wert ist eine JavaScript-Zeichenkette?"

#: learning_with_francis/subjects.py:63
msgid "Quoted text is a string. Numbers and booleans are different value types."
msgstr "Text in Anführungszeichen ist eine Zeichenkette. Zahlen und boolesche Werte sind andere Werttypen."

#: learning_with_francis/subjects.py:64
msgid "Which declaration allows later reassignment?"
msgstr "Welche Deklaration erlaubt eine spätere Neuzuweisung?"

#: learning_with_francis/subjects.py:64
msgid "Use let for a variable whose value will be reassigned."
msgstr "Verwende let für eine Variable, der später ein anderer Wert zugewiesen wird."

#: learning_with_francis/subjects.py:65
msgid "What does const prevent?"
msgstr "Was verhindert const?"

#: learning_with_francis/subjects.py:65
msgid "All clicks"
msgstr "Sämtliche Klicks"

#: learning_with_francis/subjects.py:65
msgid "Reading the variable"
msgstr "Das Lesen der Variable"

#: learning_with_francis/subjects.py:65
msgid "Reassigning that variable binding"
msgstr "Die Neuzuweisung dieser Variablenbindung"

#: learning_with_francis/subjects.py:65
msgid "A const binding cannot be reassigned. It does not freeze an object's properties."
msgstr ""
"Einer const-Bindung kann kein anderer Wert zugewiesen werden. Die Eigenschaften eines Objekts "
"werden dadurch nicht unveränderlich."

#: learning_with_francis/subjects.py:66
msgid "What does document.querySelector('#message') select?"
msgstr "Was wählt document.querySelector('#message') aus?"

#: learning_with_francis/subjects.py:66
msgid "Every button"
msgstr "Jeden Button"

#: learning_with_francis/subjects.py:66
msgid "The first element with id message"
msgstr "Das erste Element mit der id message"

#: learning_with_francis/subjects.py:66
msgid "A database row"
msgstr "Eine Datenbankzeile"

#: learning_with_francis/subjects.py:66
msgid "The # selector matches an HTML id. querySelector returns the first match."
msgstr "Der Selektor # sucht nach einer HTML-id. querySelector liefert den ersten Treffer."

#: learning_with_francis/subjects.py:67
msgid "What is returned if querySelector finds no match?"
msgstr "Was wird zurückgegeben, wenn querySelector keinen Treffer findet?"

#: learning_with_francis/subjects.py:67
msgid "An empty paragraph"
msgstr "Ein leerer Absatz"

#: learning_with_francis/subjects.py:67
msgid "The number 1"
msgstr "Die Zahl 1"

#: learning_with_francis/subjects.py:67
msgid "A missing match returns null. Check it before accessing element properties."
msgstr ""
"Ohne Treffer wird null zurückgegeben. Prüfe das, bevor du auf Eigenschaften des Elements "
"zugreifst."

#: learning_with_francis/subjects.py:68
msgid "Which property changes an element's plain text?"
msgstr "Welche Eigenschaft ändert den reinen Text eines Elements?"

#: learning_with_francis/subjects.py:68
msgid "Assign a string to textContent to replace an element's text."
msgstr "Weise textContent eine Zeichenkette zu, um den Text eines Elements zu ersetzen."

#: learning_with_francis/subjects.py:69
msgid "Which event name represents a button press with a mouse?"
msgstr "Welcher Ereignisname steht für einen Mausklick auf einen Button?"

#: learning_with_francis/subjects.py:69
msgid "A click listener runs when a click event occurs, including keyboard activation of a button."
msgstr ""
"Ein click-Handler wird bei einem Klickereignis ausgeführt, auch bei der Aktivierung eines Buttons"
" über die Tastatur."

#: learning_with_francis/subjects.py:70
msgid "Which method registers an event handler?"
msgstr "Welche Methode registriert einen Ereignishandler?"

#: learning_with_francis/subjects.py:70
msgid "addEventListener connects an event name to a function that will handle it."
msgstr "addEventListener verknüpft einen Ereignisnamen mit einer Funktion, die das Ereignis verarbeitet."

#: learning_with_francis/subjects.py:71
msgid "When does the function passed to a click listener normally run?"
msgstr "Wann wird die Funktion eines click-Handlers normalerweise ausgeführt?"

#: learning_with_francis/subjects.py:71
msgid "When the variable is declared"
msgstr "Wenn die Variable deklariert wird"

#: learning_with_francis/subjects.py:71
msgid "Before the page exists"
msgstr "Bevor die Seite existiert"

#: learning_with_francis/subjects.py:71
msgid "When the click event occurs"
msgstr "Wenn das Klickereignis eintritt"

#: learning_with_francis/subjects.py:71
msgid "Registering the handler waits for future events. It does not call the handler immediately."
msgstr "Die Registrierung wartet auf spätere Ereignisse. Sie ruft die Funktion nicht sofort auf."

#: learning_with_francis/subjects.py:72
msgid "Why place a simple DOM script after the HTML it uses?"
msgstr "Warum steht ein einfaches DOM-Skript hinter dem HTML, das es verwendet?"

#: learning_with_francis/subjects.py:72
msgid "To create a login"
msgstr "Um eine Anmeldung zu erstellen"

#: learning_with_francis/subjects.py:72
msgid "So the elements exist before selection"
msgstr "Damit die Elemente vor der Auswahl existieren"

#: learning_with_francis/subjects.py:72
msgid "To turn text into SQL"
msgstr "Um Text in SQL umzuwandeln"

#: learning_with_francis/subjects.py:72
msgid "The browser parses those elements first, so querySelector can find them."
msgstr "Der Browser verarbeitet zuerst diese Elemente, sodass querySelector sie finden kann."

#: learning_with_francis/subjects.py:75
msgid "Which value is a boolean?"
msgstr "Welcher Wert ist ein boolescher Wert?"

#: learning_with_francis/subjects.py:75
msgid "Unquoted true is a boolean. 'true' is text."
msgstr "true ohne Anführungszeichen ist ein boolescher Wert. 'true' ist Text."

#: learning_with_francis/subjects.py:76
msgid "What can follow let score = 1; to change score to 2?"
msgstr "Welche Anweisung kann nach let score = 1; den Wert von score auf 2 ändern?"

#: learning_with_francis/subjects.py:76
msgid "The equals sign assigns the new value. let allows reassignment."
msgstr "Das Gleichheitszeichen weist den neuen Wert zu. let erlaubt eine Neuzuweisung."

#: learning_with_francis/subjects.py:77
msgid "How do you select the element with id greeting?"
msgstr "Wie wählst du das Element mit der id greeting aus?"

#: learning_with_francis/subjects.py:77
msgid "The # character identifies an id in a CSS selector."
msgstr "Das Zeichen # kennzeichnet in einem CSS-Selektor eine id."

#: learning_with_francis/subjects.py:78
msgid "Which statement replaces a selected element's text?"
msgstr "Welche Anweisung ersetzt den Text eines ausgewählten Elements?"

#: learning_with_francis/subjects.py:78
msgid "Assigning textContent updates plain text in the DOM."
msgstr "Eine Zuweisung an textContent aktualisiert den reinen Text im DOM."

#: learning_with_francis/subjects.py:79
msgid "What does button.addEventListener('click', handler) do?"
msgstr "Was bewirkt button.addEventListener('click', handler)?"

#: learning_with_francis/subjects.py:79
msgid "Calls handler immediately"
msgstr "Ruft handler sofort auf"

#: learning_with_francis/subjects.py:79
msgid "Saves a quiz score"
msgstr "Speichert ein Quizergebnis"

#: learning_with_francis/subjects.py:79
msgid "Registers handler to run on a click"
msgstr "Registriert handler für ein Klickereignis"

#: learning_with_francis/subjects.py:79
msgid "The function is passed as a handler. The event triggers it later."
msgstr "Die Funktion wird als Handler übergeben. Erst das Ereignis löst ihren Aufruf aus."

#: learning_with_francis/subjects.py:84
msgid "What does ERP stand for?"
msgstr "Wofür steht ERP?"

#: learning_with_francis/subjects.py:84
msgid "ERP means Enterprise Resource Planning: connected software for core business processes."
msgstr "ERP steht für Enterprise Resource Planning: vernetzte Software für zentrale Geschäftsprozesse."

#: learning_with_francis/subjects.py:85
msgid "Why connect purchasing, inventory and finance?"
msgstr "Warum werden Einkauf, Lager und Finanzwesen miteinander verbunden?"

#: learning_with_francis/subjects.py:85
msgid "To hide all records"
msgstr "Um alle Datensätze zu verbergen"

#: learning_with_francis/subjects.py:85
msgid "To share consistent business information"
msgstr "Um einheitliche Geschäftsinformationen zu teilen"

#: learning_with_francis/subjects.py:85
msgid "To remove every business rule"
msgstr "Um jede Geschäftsregel abzuschaffen"

#: learning_with_francis/subjects.py:85
msgid "Shared information helps departments coordinate without retyping the same facts independently."
msgstr ""
"Gemeinsame Informationen helfen Abteilungen bei der Abstimmung, ohne dieselben Angaben unabhängig"
" erneut einzugeben."

#: learning_with_francis/subjects.py:86
msgid "Which is an example of master data?"
msgstr "Was ist ein Beispiel für Stammdaten?"

#: learning_with_francis/subjects.py:86
msgid "Today's delivery event"
msgstr "Die heutige Lieferung"

#: learning_with_francis/subjects.py:86
msgid "One supplier invoice"
msgstr "Eine einzelne Lieferantenrechnung"

#: learning_with_francis/subjects.py:86
msgid "A supplier's address"
msgstr "Die Adresse eines Lieferanten"

#: learning_with_francis/subjects.py:86
msgid "Master data describes reusable business entities such as suppliers, customers and materials."
msgstr ""
"Stammdaten beschreiben wiederverwendbare Geschäftseinheiten wie Lieferanten, Kunden und "
"Materialien."

#: learning_with_francis/subjects.py:87
msgid "Which is transactional data?"
msgstr "Was sind Bewegungsdaten?"

#: learning_with_francis/subjects.py:87
msgid "A material description"
msgstr "Eine Materialbeschreibung"

#: learning_with_francis/subjects.py:87
msgid "A particular purchase order"
msgstr "Eine bestimmte Bestellung"

#: learning_with_francis/subjects.py:87
msgid "A supplier's contact details"
msgstr "Die Kontaktdaten eines Lieferanten"

#: learning_with_francis/subjects.py:87
msgid "A purchase order records a specific business event rather than general supplier information."
msgstr ""
"Eine Bestellung erfasst einen konkreten Geschäftsvorgang, keine allgemeinen "
"Lieferanteninformationen."

#: learning_with_francis/subjects.py:88
msgid "A shop buys chairs from a supplier. Which document records what it orders?"
msgstr "Ein Geschäft kauft Stühle bei einem Lieferanten. Welcher Beleg hält die Bestellung fest?"

#: learning_with_francis/subjects.py:88 learning_with_francis/subjects.py:98
msgid "Purchase order"
msgstr "Bestellung"

#: learning_with_francis/subjects.py:88
msgid "Customer payment"
msgstr "Kundenzahlung"

#: learning_with_francis/subjects.py:88
msgid "Website stylesheet"
msgstr "Stylesheet einer Webseite"

#: learning_with_francis/subjects.py:88
msgid "A purchase order records the goods and quantities being ordered from a supplier."
msgstr "Eine Bestellung erfasst die bei einem Lieferanten bestellten Waren und Mengen."

#: learning_with_francis/subjects.py:89
msgid "The ordered chairs arrive. Which step records their arrival?"
msgstr "Die bestellten Stühle treffen ein. Welcher Schritt erfasst ihre Ankunft?"

#: learning_with_francis/subjects.py:89
msgid "Send a sales quote"
msgstr "Ein Verkaufsangebot senden"

#: learning_with_francis/subjects.py:89
msgid "Register a new learner"
msgstr "Eine neue lernende Person registrieren"

#: learning_with_francis/subjects.py:89
msgid "Post a goods receipt"
msgstr "Einen Wareneingang buchen"

#: learning_with_francis/subjects.py:89
msgid "A goods receipt records that goods have been received. In this stock example it updates inventory."
msgstr ""
"Ein Wareneingang erfasst den Erhalt von Waren. In diesem Lagerbeispiel aktualisiert er den "
"Bestand."

#: learning_with_francis/subjects.py:90
msgid "After receiving a supplier invoice, what should the company do before payment?"
msgstr "Was sollte das Unternehmen nach Eingang einer Lieferantenrechnung vor der Zahlung tun?"

#: learning_with_francis/subjects.py:90
msgid "Check it against the order and receipt"
msgstr "Sie mit Bestellung und Wareneingang vergleichen"

#: learning_with_francis/subjects.py:90
msgid "Always pay without checking"
msgstr "Immer ungeprüft bezahlen"

#: learning_with_francis/subjects.py:90
msgid "Delete the supplier"
msgstr "Den Lieferanten löschen"

#: learning_with_francis/subjects.py:90
msgid ""
"Checking the order, receipt and invoice helps identify quantity or price differences before "
"payment."
msgstr ""
"Der Vergleich von Bestellung, Wareneingang und Rechnung hilft, Mengen- oder Preisabweichungen vor"
" der Zahlung zu erkennen."

#: learning_with_francis/subjects.py:91
msgid "Which is a simplified purchasing sequence?"
msgstr "Welche Abfolge beschreibt einen vereinfachten Einkaufsprozess?"

#: learning_with_francis/subjects.py:91
msgid "Pay, delete, forget"
msgstr "Bezahlen, löschen, vergessen"

#: learning_with_francis/subjects.py:91
msgid "Purchase order, goods receipt, invoice check, payment"
msgstr "Bestellung, Wareneingang, Rechnungsprüfung, Zahlung"

#: learning_with_francis/subjects.py:91
msgid "Customer payment, customer order, purchase order"
msgstr "Kundenzahlung, Kundenauftrag, Bestellung"

#: learning_with_francis/subjects.py:91
msgid ""
"This common stock-purchasing example connects buying, receiving and finance; real workflows can "
"vary."
msgstr ""
"Dieses häufige Beispiel für den Lagereinkauf verbindet Beschaffung, Warenannahme und Finanzwesen."
" Tatsächliche Abläufe können abweichen."

#: learning_with_francis/subjects.py:92
msgid "A customer orders products from the shop. Which document records that request?"
msgstr "Ein Kunde bestellt Produkte beim Geschäft. Welcher Beleg erfasst diesen Wunsch?"

#: learning_with_francis/subjects.py:92
msgid "Supplier invoice"
msgstr "Lieferantenrechnung"

#: learning_with_francis/subjects.py:92
msgid "Goods receipt from a supplier"
msgstr "Wareneingang eines Lieferanten"

#: learning_with_francis/subjects.py:92
msgid "Sales order"
msgstr "Kundenauftrag"

#: learning_with_francis/subjects.py:92
msgid "A sales order records what the business agrees to supply to a customer."
msgstr ""
"Ein Kundenauftrag erfasst, welche Produkte oder Leistungen das Unternehmen einem Kunden liefern "
"soll."

#: learning_with_francis/subjects.py:93
msgid "What is this SAP lesson designed to teach?"
msgstr "Was soll diese SAP-Lektion vermitteln?"

#: learning_with_francis/subjects.py:93
msgid "How to access a real company's SAP system"
msgstr "Zugang zum SAP-System eines echten Unternehmens"

#: learning_with_francis/subjects.py:93
msgid "Basic connected business-process concepts"
msgstr "Grundlagen vernetzter Geschäftsprozesse"

#: learning_with_francis/subjects.py:93
msgid "That a quiz score proves business expertise"
msgstr "Dass ein Quizergebnis geschäftliche Fachkenntnisse beweist"

#: learning_with_francis/subjects.py:93
msgid ""
"These are simplified learning scenarios. They do not run SAP transactions or confirm your "
"understanding automatically."
msgstr ""
"Dies sind vereinfachte Lernszenarien. Sie führen keine SAP-Transaktionen aus und bestätigen dein "
"Verständnis nicht automatisch."

#: learning_with_francis/subjects.py:96
msgid "What is a main purpose of ERP?"
msgstr "Was ist ein Hauptzweck von ERP?"

#: learning_with_francis/subjects.py:96
msgid "Only drawing webpages"
msgstr "Nur Webseiten zeichnen"

#: learning_with_francis/subjects.py:96
msgid "Connecting core business processes and data"
msgstr "Zentrale Geschäftsprozesse und Daten verbinden"

#: learning_with_francis/subjects.py:96
msgid "Replacing all human decisions"
msgstr "Alle menschlichen Entscheidungen ersetzen"

#: learning_with_francis/subjects.py:96
msgid "ERP connects business work such as sales, procurement, inventory and finance."
msgstr "ERP verbindet Geschäftsbereiche wie Vertrieb, Beschaffung, Lager und Finanzwesen."

#: learning_with_francis/subjects.py:97
msgid "Which item is master data?"
msgstr "Welche Angabe gehört zu den Stammdaten?"

#: learning_with_francis/subjects.py:97
msgid "One goods receipt"
msgstr "Ein einzelner Wareneingang"

#: learning_with_francis/subjects.py:97
msgid "One invoice"
msgstr "Eine einzelne Rechnung"

#: learning_with_francis/subjects.py:97
msgid "A customer's address"
msgstr "Die Adresse eines Kunden"

#: learning_with_francis/subjects.py:97
msgid ""
"A customer's address is reusable business information; invoices and receipts describe specific "
"events."
msgstr ""
"Die Adresse eines Kunden ist eine wiederverwendbare Geschäftsinformation. Rechnungen und "
"Wareneingänge beschreiben einzelne Vorgänge."

#: learning_with_francis/subjects.py:98
msgid "Which document orders goods from a supplier?"
msgstr "Welcher Beleg bestellt Waren bei einem Lieferanten?"

#: learning_with_francis/subjects.py:98
msgid "Sales invoice to a customer"
msgstr "Ausgangsrechnung an einen Kunden"

#: learning_with_francis/subjects.py:98
msgid "Browser event"
msgstr "Browserereignis"

#: learning_with_francis/subjects.py:98
msgid "A purchase order specifies a business's requested goods or services from a supplier."
msgstr ""
"Eine Bestellung legt fest, welche Waren oder Dienstleistungen ein Unternehmen bei einem "
"Lieferanten anfordert."

#: learning_with_francis/subjects.py:99
msgid "In the chair example, what records delivery into stock?"
msgstr "Was erfasst im Stuhlbeispiel die Lieferung in das Lager?"

#: learning_with_francis/subjects.py:99
msgid "A new variable"
msgstr "Eine neue Variable"

#: learning_with_francis/subjects.py:99
msgid "A goods receipt"
msgstr "Ein Wareneingang"

#: learning_with_francis/subjects.py:99
msgid "A customer payment"
msgstr "Eine Kundenzahlung"

#: learning_with_francis/subjects.py:99
msgid "The goods receipt records incoming goods and updates stock in this example."
msgstr "Der Wareneingang erfasst eingehende Waren und aktualisiert in diesem Beispiel den Lagerbestand."

#: learning_with_francis/subjects.py:100
msgid "Why check a supplier invoice against its order and receipt?"
msgstr "Warum wird eine Lieferantenrechnung mit Bestellung und Wareneingang verglichen?"

#: learning_with_francis/subjects.py:100
msgid "To change learning status"
msgstr "Um den Lernstatus zu ändern"

#: learning_with_francis/subjects.py:100
msgid "To skip inventory records"
msgstr "Um Lageraufzeichnungen zu überspringen"

#: learning_with_francis/subjects.py:100
msgid "To find differences before payment"
msgstr "Um Abweichungen vor der Zahlung zu finden"

#: learning_with_francis/subjects.py:100
msgid ""
"Comparing these records helps check that billed quantities and prices match the agreed and "
"received goods."
msgstr ""
"Der Vergleich hilft zu prüfen, ob die berechneten Mengen und Preise mit den vereinbarten und "
"erhaltenen Waren übereinstimmen."

#: learning_with_francis/subjects.py:105
msgid "Variables and simple functions"
msgstr "Variablen und einfache Funktionen"

#: learning_with_francis/subjects.py:106
msgid "Values, DOM elements, and events"
msgstr "Werte, DOM-Elemente und Ereignisse"

#: learning_with_francis/subjects.py:107
msgid "Basic ERP concepts and business-process scenarios"
msgstr "ERP-Grundlagen und Geschäftsprozessbeispiele"

